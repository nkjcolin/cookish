# The app never loads .env implicitly. Use uv run --env-file .env or docker --env-file.
# Existing environment settings take precedence when using uv.
AI_PROVIDER=fake

# Set AI_PROVIDER=soclaas to enable real school API calls.
# Supply the API base URL (usually ending in /v1), not /chat/completions.
SOCLAAS_BASE_URL=https://school-api.example/v1
SOCLAAS_MODEL=
SOCLAAS_API_KEY=

# Optional model overrides; empty values use SOCLAAS_MODEL.
SOCLAAS_IMAGE_MODEL=
# Grocery photos use per-package/object evidence before Python aggregates totals.
# instances is the default; factors selects the previous prompt/schema.
SOCLAAS_PHOTO_QUANTITY_MODE=instances
SOCLAAS_TEXT_MODEL=
SOCLAAS_INTERPRET_MODEL=

# Speech-to-text model for /ai/transcribe-audio and the standalone laas.py test.
# Required only for real audio transcription; never falls back to SOCLAAS_MODEL.
SOCLAAS_AUDIO_MODEL=

# json_schema matches the prototype's structured-output requests.
# Choose json_object only if the school endpoint does not support JSON schemas.
SOCLAAS_OUTPUT_MODE=json_schema
SOCLAAS_MAX_OUTPUT_TOKENS=4096
SOCLAAS_TIMEOUT_SECONDS=20
SOCLAAS_PRICING_CACHE_SECONDS=3600
AI_REQUEST_TIMEOUT_SECONDS=27
# For slow LOCAL experiments only: provider timeout 60, request timeout 90,
# helper --timeout 100. Lambda always caps the request budget at 27 seconds
# or the invocation's remaining time minus one second, whichever is smaller.

# Image jobs: run the API and a separate python -m app.job_worker process locally.
# Both processes must use the same directory. Never set local storage on Lambda.
AI_JOB_BACKEND=local
# AI_JOB_LOCAL_DIR=/absolute/path/to/ai/output/jobs
AI_WORKER_TIMEOUT_SECONDS=110
# For real school-model image jobs, set SOCLAAS_TIMEOUT_SECONDS=90 in the worker.
# SAM supplies these three references when AI_JOB_BACKEND=aws:
# AI_JOB_BUCKET=
# AI_JOB_TABLE=
# AI_JOB_QUEUE_URL=

# AWS alternative: supply this instead of SOCLAAS_API_KEY.
# The secret may be a raw key or JSON containing SOCLAAS_API_KEY or api_key.
# SOCLAAS_API_KEY_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:NAME

# Extraction returns food names only; no ingredient catalogue is required.
