# Leave empty in development: Vite proxies /api and /ai to the backend.
# Set to the API Gateway URL only if the frontend is served from a different origin.
VITE_API_URL=

# Where the dev server forwards /api and /ai.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_PROXY_TARGET=http://localhost:8000